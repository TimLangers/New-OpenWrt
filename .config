# =========================================================
# 硬件与固件基础架构配置 (x86_64 专属)
# =========================================================
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# =========================================================
# 容量定制 (256MB 引导分区 + 2048MB/2GB 根分区)
# =========================================================
CONFIG_TARGET_KERNEL_PARTSIZE=256
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# =========================================================
# LuCI 网页后台与颜值主题 (默认启用 Argon)
# =========================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
# CONFIG_PACKAGE_luci-theme-bootstrap is not set

# =========================================================
# 核心服务菜单插件 (极致精简，无杂质)
# =========================================================
# 1. PassWall (针对 25.x 官方源码 nftables/fw4 规则适配)
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y

# 2. OpenClash (Mihomo 内核全协议支持)
CONFIG_PACKAGE_luci-app-openclash=y

# 3. UPnP 自动端口映射
CONFIG_PACKAGE_luci-app-upnp=y

# =========================================================
# 强力底层与网络加速组件 (超级小钢炮配置)
# =========================================================
# TurboACC 网络加速 (跑满千兆、降低 CPU 负载)
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR-CCA=y

# 核心网络及系统运维工具 (订阅更新不报错、方便排查)
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_resize2fs=y

# =========================================================
# 彻底清理杂项 (确保菜单纯净，屏蔽官方自带的臃肿应用)
# =========================================================
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_luci-app-ttyd is not set
# CONFIG_PACKAGE_luci-app-wol is not set
CONFIG_PACKAGE_luci-app-firewall=y

# =========================================================
# 语言与汉化包配置 (确保系统与所有核心插件全中文)
# =========================================================
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
