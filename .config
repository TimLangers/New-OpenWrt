# 架构与核心基础
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_KERNEL_PARTSIZE=256
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# 基础系统与网络
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_bind-tools=y

# ====================== 推荐补充的常用包 ======================

# 常用工具
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_luci-app-ttyd=y          # 网页终端
CONFIG_PACKAGE_luci-app-diskman=y       # 磁盘管理
CONFIG_PACKAGE_luci-app-smartdns=y      # SmartDNS
CONFIG_PACKAGE_luci-app-passwall=y      # 可选（和 OpenClash 二选一）
# CONFIG_PACKAGE_luci-app-ssr-plus=y    # 如果需要也可以加

# 文件系统支持（x86 软路由建议加上）
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs=y
CONFIG_PACKAGE_exfatprogs=y
CONFIG_PACKAGE_ntfs-3g=y

# 其他实用
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_iperf3=y

# LuCI 界面
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_LUCI_LANG_zh-hans=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# 核心功能插件
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_sing-box=y
CONFIG_SINGBOX_WITH_TAILSCALE=y
CONFIG_SINGBOX_WITH_QUIC=y
CONFIG_SINGBOX_WITH_WIREGUARD=y
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR-CCA=y
CONFIG_PACKAGE_luci-app-upnp=y

# IPv6 支持
CONFIG_IPV6=y
CONFIG_KERNEL_IPV6=y
CONFIG_PACKAGE_libustream-openssl=y
