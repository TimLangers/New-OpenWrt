# =========================================================
# OpenWrt 配置文件 (x86_64 专用 - 仅保留 OpenClash)
# =========================================================

# 1. 硬件架构 (x86_64)
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# 2. 固件分区
CONFIG_TARGET_KERNEL_PARTSIZE=256
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# 3. 基础系统
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_dnsmasq-full=y

# 4. 网络基础
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_ip-full=y

# 5. LuCI 界面
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-lib-jsonc=y

# 6. LuCI 语言与主题
CONFIG_LUCI_LANG_zh-hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-hans=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-hans=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# 7. 科学上网 - OpenClash (已移除 PassWall)
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-hans=y

# 8. 网络工具与流量加速
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-hans=y
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_fullconenat=y
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-hans=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR-CCA=y

# 9. 系统工具包
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_iputils-traceroute=y
CONFIG_PACKAGE_bind-tools=y

# 10. Sing-box 核心内核支持
CONFIG_PACKAGE_sing-box=y
CONFIG_SINGBOX_WITH_TAILSCALE=y
CONFIG_SINGBOX_WITH_QUIC=y
CONFIG_SINGBOX_WITH_WIREGUARD=y
CONFIG_SINGBOX_WITH_GVISOR=y
CONFIG_SINGBOX_WITH_UTLS=y
CONFIG_SINGBOX_WITH_CLASH_API=y

# 11. 默认设置
CONFIG_TARGET_INIT_LOCAL_IP="10.1.1.1"
CONFIG_TARGET_INIT_NETMASK="255.255.255.0"
CONFIG_IPV6=y
CONFIG_KERNEL_IPV6=y
CONFIG_PACKAGE_libustream-openssl=y

# 12. 编译优化
CONFIG_STRIP_KERNEL_EXPORTS=y
CONFIG_USE_STRIP=y
