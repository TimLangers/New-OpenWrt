# =========================================================
# 硬件与固件基础架构配置 (x86_64 专属)
# =========================================================
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# =========================================================
# 容量定制 (256MB 引导分区 + 2048MB/2GB 根分区)
# =========================================================
CONFIG_TARGET_KERNEL_PARTSIZE=256
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# =========================================================
# LuCI 网页后台与内核组件
# =========================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-mod-admin-full=y

# =========================================================
# 2026 新版 LuCI Master 核心汉化配置 (解决不生效的关键)
# =========================================================
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_LUCI_LANG_zh-hans=y
CONFIG_PACKAGE_luci-i18n-base-zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-hans=y

# 插件对应的汉化包（新系统会自动映射新包名）
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y

# =========================================================
# 适配新架构的最新 Argon 主题 (必须搭配你最新的 diy-part1 脚本)
# =========================================================
CONFIG_PACKAGE_luci-theme-argon=y

# 保留默认 bootstrap 主题作为安全备用，防止主题层面的语言错乱
CONFIG_PACKAGE_luci-theme-bootstrap=y

# =========================================================
# PPPoE 拨号与防火墙 (fw4/nftables 原生支持)
# =========================================================
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_ipv6helper=y

CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_luci-app-firewall=y

# =========================================================
# 核心网络插件 (极致精简)
# =========================================================
# 1. PassWall (fw4 适配版)
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y

# 2. OpenClash (Mihomo 全协议支持)
CONFIG_PACKAGE_luci-app-openclash=y

# 3. UPnP 自动端口映射与 FullCone NAT
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_fullconenat=y

# 4. TurboACC 网络加速 (软路由上：建议仅开启 Flow Offloading，关闭 SFE 避免跟拨号冲突)
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR-CCA=y
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE is not set

# =========================================================
# 系统必备运维工具
# =========================================================
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_kmod-tun=y
# =========================================================
# 局域网默认登录 IP 与标准掩码硬编码
# =========================================================
CONFIG_TARGET_INIT_LOCAL_IP="10.1.1.1"
CONFIG_TARGET_INIT_NETMASK="255.255.255.0"
