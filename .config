# =========================================================
# OpenWrt 完整配置文件（x86_64 精简强力版）
# =========================================================

# =========================================================
# 硬件架构
# =========================================================
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# =========================================================
# 固件分区大小
# =========================================================
CONFIG_TARGET_KERNEL_PARTSIZE=256
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# =========================================================
# 基础系统组件
# =========================================================
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libstdcpp=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y

# =========================================================
# LuCI 网页界面
# =========================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y

# 汉化
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_LUCI_LANG_zh-hans=y
CONFIG_PACKAGE_luci-i18n-base-zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-hans=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y

# =========================================================
# 主题
# =========================================================
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# =========================================================
# 网络与防火墙
# =========================================================
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_ip-full=y

# =========================================================
# 核心科学上网插件
# =========================================================
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y

CONFIG_PACKAGE_luci-app-openclash=y

CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_fullconenat=y

# TurboACC
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR-CCA=y
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE is not set

# =========================================================
# 系统工具
# =========================================================
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y

# =========================================================
# 【重要】sing-box 配置（full 版本 + Tailscale）
# =========================================================
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_sing-box-full=y
# CONFIG_PACKAGE_sing-box-tiny is not set

CONFIG_SINGBOX_WITH_TAILSCALE=y
CONFIG_SINGBOX_WITH_QUIC=y
CONFIG_SINGBOX_WITH_WIREGUARD=y
CONFIG_SINGBOX_WITH_GVISOR=y
CONFIG_SINGBOX_WITH_UTLS=y
CONFIG_SINGBOX_WITH_CLASH_API=y
# CONFIG_SINGBOX_WITH_ACME is not set
# CONFIG_SINGBOX_WITH_EMBEDDED_TOR is not set
# CONFIG_SINGBOX_WITH_GRPC is not set
# CONFIG_SINGBOX_WITH_DHCP is not set
# CONFIG_SINGBOX_WITH_V2RAY_API is not set

# =========================================================
# 默认 LAN IP 配置
# =========================================================
CONFIG_TARGET_INIT_LOCAL_IP="10
